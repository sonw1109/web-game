    "node": ">=20"
  },
  "dependencies": {
    "express": "^5.3.0",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "socket.io-client": "^4.8.4",
    "three": "^0.170.0",
    "vite": "^8.3.5"
  }
}
